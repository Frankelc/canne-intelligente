# Copier en .env (deploy/deploy.sh le fait au premier lancement).
# Les mots de passe laissés à CHANGE_ME sont générés automatiquement par deploy/deploy.sh.

# Nom de domaine qui pointe vers l'IP du VPS (ex. sous-domaine gratuit DuckDNS)
DOMAIN=REPLACE_WITH_DOMAIN
ACME_EMAIL=REPLACE_WITH_EMAIL

# Comptes MQTT (mosquitto/acl est généré à partir de ces valeurs par deploy/deploy.sh)
MQTT_USER=canne01
MQTT_PASSWORD=CHANGE_ME
MQTT_TELEGRAM_USER=telegram
MQTT_TELEGRAM_PASSWORD=CHANGE_ME
MQTT_DASHBOARD_USER=dashboard
MQTT_DASHBOARD_PASSWORD=CHANGE_ME
MQTT_TOPIC_PREFIX=ifri/seiot/projet3/canne01

TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN
# Plusieurs destinataires possibles, séparés par des virgules (ex. proche + téléphone du jury)
TELEGRAM_CHAT_ID=REPLACE_WITH_CHAT_ID
SOS_COOLDOWN_SECONDS=30

# Accès au dashboard https://DOMAIN
DASHBOARD_USER=jury
DASHBOARD_PASSWORD=CHANGE_ME
DASHBOARD_PASSWORD_HASH=
